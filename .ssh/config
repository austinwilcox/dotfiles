# macOS-only keyword; must be global so non-matching hosts still parse on Linux
IgnoreUnknown UseKeychain

# Work account (austinwilcox1) is the DEFAULT for github.com.
# IdentitiesOnly matters: without it ssh offers every other key too, and
# whichever GitHub accepts first wins regardless of the order here.
Host github.com
	HostName github.com
	User git
	ForwardAgent yes
	IdentitiesOnly yes
	IdentityFile ~/.ssh/arblaptop

# Same work key, kept so existing git@github-work:ORG/REPO.git remotes keep working.
Host github-work
	HostName github.com
	User git
	ForwardAgent yes
	IdentitiesOnly yes
	IdentityFile ~/.ssh/arblaptop

# Personal account (austinwilcox). Use git@github-personal:USER/REPO.git as the remote.
Host github-personal
	HostName github.com
	User git
	ForwardAgent yes
	IdentitiesOnly yes
	IdentityFile ~/.ssh/github_rsa
Host gitlab.com
	HostName gitlab.com
	User git
	ForwardAgent yes
	IdentityFile ~/.ssh/gitlab_rsa
Host gitlab.com
	HostName gitlab.com
	User git
	ForwardAgent yes
	IdentityFile ~/.ssh/gitlab_Aug2022
Host gitea-ssh.austinwilcox.dev
  HostName gitea-ssh.austinwilcox.dev
  ProxyCommand cloudflared access ssh --hostname %h
  User git
  ForwardAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/gitea_homelab
Host laptop
  HostName 192.168.1.37
  User austin
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_arblaptop
  IdentitiesOnly yes
